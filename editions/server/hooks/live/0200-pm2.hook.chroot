#!/bin/sh
# PM2 isn't packaged in Debian; install it globally from npm.
set -e
npm install -g pm2 --no-fund --no-audit
pm2 --version
npm cache clean --force >/dev/null 2>&1 || true

# SSH on by default for a server; passwords stay allowed until you add keys.
systemctl enable ssh 2>/dev/null || true
