#!/bin/sh
# Steam is 32-bit: enable i386, accept the license, install it + 32-bit Mesa.
set -e

dpkg --add-architecture i386
echo "steam steam/question select I AGREE"           | debconf-set-selections
echo "steam steam/license note ''"                   | debconf-set-selections
echo "steam-installer steam/question select I AGREE" | debconf-set-selections

# Our own repo may not be online yet during the very first builds;
# keep it out of this apt run so it can't fail the build.
SRC=/etc/apt/sources.list.d/cigamingos.sources
[ -f "$SRC" ] && mv "$SRC" "$SRC.hold"

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y \
  steam-installer \
  libgl1-mesa-dri:i386 libglx-mesa0:i386 mesa-vulkan-drivers:i386 libvulkan1:i386

[ -f "$SRC.hold" ] && mv "$SRC.hold" "$SRC"
apt-get clean
