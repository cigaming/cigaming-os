#!/bin/sh
set -e
# Hand Debian its files back.
if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
  for f in /etc/issue /etc/issue.net; do
    [ -L "$f" ] && [ "$(readlink "$f")" = "/usr/share/cigamingos/${f#/etc/}" ] && rm -f "$f"
  done
  for f in /usr/lib/os-release /etc/issue /etc/issue.net; do
    dpkg-divert --package cigamingos-branding --remove --rename \
      --divert "$f.debian" "$f" >/dev/null || true
  done
fi
exit 0
