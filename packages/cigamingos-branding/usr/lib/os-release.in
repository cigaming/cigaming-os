PRETTY_NAME="@OS_NAME@ @OS_VERSION@ (@OS_CODENAME_PRETTY@)"
NAME="@OS_NAME@"
VERSION_ID="@OS_VERSION@"
VERSION="@OS_VERSION@ (@OS_CODENAME_PRETTY@)"
# VERSION_CODENAME stays the Debian codename on purpose: third-party
# installers (NodeSource, Docker, Tailscale...) build apt URLs from it.
VERSION_CODENAME=@DEBIAN_BASE@
DEBIAN_CODENAME=@DEBIAN_BASE@
CIGAMINGOS_CODENAME=@OS_CODENAME@
ID=@OS_ID@
ID_LIKE=debian
LOGO=cigamingos
ANSI_COLOR="38;2;245;165;36"
HOME_URL="@HOME_URL@"
SUPPORT_URL="@SUPPORT_URL@"
BUG_REPORT_URL="@BUG_URL@"
