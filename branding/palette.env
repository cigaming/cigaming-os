# CiGaming OS brand palette — the single source of truth for every
# generated asset (wallpaper, logo, GRUB, Plymouth, KDE colors, Calamares).
#
# Swap these for the exact hex values from os.cigaming.dev and run
# `make assets` — everything regenerates to match the web OS.

OS_NAME="CiGaming OS"
OS_ID="cigamingos"
OS_VERSION="1.1"
OS_CODENAME="cub"
OS_CODENAME_PRETTY="Cub"
DEBIAN_BASE="trixie"
HOME_URL="https://os.cigaming.dev"
SUPPORT_URL="https://os.cigaming.dev/docs"
BUG_URL="https://github.com/cigaming/cigaming-os/issues"
REPO_URL="https://repo.cigaming.dev"

# Colors
NIGHT="#16122b"     # deepest background
PLUM="#2a2150"      # panels / secondary background
DUSK="#3d2f73"      # highlights on dark
AMBER="#f5a524"     # primary brand color (lion gold)
MANE="#e0702e"      # warm accent
CREAM="#fff4e0"     # text on dark
TEAL="#4fd1c5"      # cool accent / links
